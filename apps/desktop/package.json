{
  "name": "@alethic/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alethic desktop shell (Electron main + React renderer). Scaffolded in Phase 0; wired in Phase 2+.",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "pnpm typecheck && electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "icon": "node ../../scripts/make-icon.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@alethic/agent": "workspace:*",
    "@alethic/format": "workspace:*",
    "@alethic/ipc": "workspace:*",
    "@alethic/scan": "workspace:*",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "electron-store": "^11.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.1.4"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
