{
  "name": "alethic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alethic — a spec-driven development IDE where a Minto-pyramid map of project logic is the primary surface and code is its artifact.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "pnpm --filter @alethic/desktop dev",
    "dist": "tsc -b && pnpm --filter @alethic/desktop dist",
    "build": "tsc -b && pnpm --filter @alethic/desktop build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dep:check": "depcruise \"packages/*/src\" apps/desktop/src --config .dependency-cruiser.cjs",
    "golden:scan": "node scripts/golden-scan.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "check": "pnpm build && pnpm test && pnpm lint && pnpm dep:check && pnpm format"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
